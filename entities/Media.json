{
  "name": "Media",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "photo",
        "video",
        "article",
        "generated_visual"
      ]
    },
    "url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "round": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "enum": [
        "upload",
        "url",
        "google_drive",
        "generated"
      ]
    },
    "published": {
      "type": "boolean"
    }
