{
  "name": "Lineup",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "formation": {
      "type": "string",
      "description": "ex. 2-2-1 (hors gardien)"
    },
    "starter_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "substitute_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subs_entered_ids": {
      "type": "array",
