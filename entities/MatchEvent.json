{
  "name": "MatchEvent",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "goal",
        "own_goal",
        "penalty_missed",
        "goal_disallowed",
        "shot_on_target",
        "shot_off_target",
        "save",
        "penalty_saved",
        "corner",
        "throw_in",
        "free_kick",
        "foul",
        "yellow_card",
        "second_yellow",
        "red_card",
        "substitution",
        "gk_change",
        "shootout_scored",
        "shootout_saved",
        "shootout_missed"
      ]
    },
    "goal_kind": {
      "type": "string",
      "enum": [
        "normal",
        "header",
        "penalty",
        "direct_free_kick"
      ]
    },
    "player_id": {
      "type": "string"
    },
    "player_name_free": {
      "type": "string",
      "description": "« Autre joueur » hors compo / joueur inconnu"
    },
    "related_player_id": {
      "type": "string",
      "description": "passeur / joueur sortant / gardien adverse (TAB)"
    },
    "period": {
      "type": "string",
      "enum": [
        "1H",
        "2H",
        "ET1",
        "ET2",
        "PENS"
      ]
    },
    "minute": {
      "type": "integer"
    },
    "added_minute": {
      "type": "integer",
      "description": "15+2' → minute 15, added 2"
    },
    "clock_ms": {
      "type": "integer"
    },
    "auto": {
      "type": "boolean",
      "description": "tir cadré automatique"
    },
    "parent_event_id": {
      "type": "string"
    },
    "shootout_order": {
      "type": "integer"
    },
    "client_id": {
      "type": "string",
      "description": "idempotence de la file hors ligne"
    },
    "client_ts": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "historique des corrections { at, by, before }"
    }
  },
  "required": [
    "match_id",
    "team_id",
    "type"
  ]
}
