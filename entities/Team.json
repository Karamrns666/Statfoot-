{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "short_name": {
      "type": "string",
      "maxLength": 3
    },
    "company": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string"
    },
    "secondary_color": {
      "type": "string"
    },
    "division_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "captain_player_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "inactive"
      ]
    },
    "media": {
      "type": "array",
      "description": "Photos collectives et posters de l'équipe",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "team_photo",
              "poster"
            ]
          },
          "focus_x": {
            "type": "number"
          },
          "focus_y": {
            "type": "number"
          },
          "focus_x_mobile": {
            "type": "number"
          },
          "focus_y_mobile": {
            "type": "number"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "kind"
        ]
      }
    },
    "cover_media_id": {
      "type": "string",
      "description": "Image affichée en en-tête de la page équipe"
    },
    "season_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "link": {
      "type": "object",
      "description": "lien approuvé vers la saison précédente",
      "properties": {
        "previous_id": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        }
      }
    },
    "link_dismissed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "short_name"
  ]
}