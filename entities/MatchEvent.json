{
  "name": "MatchEvent",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "minute": {
      "type": "integer"
    },
    "period": {
      "type": "string",
      "enum": [
        "1H",
        "2H",
        "ET",
        "PENS"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "goal",
        "assist",
        "own_goal",
        "penalty_goal",
        "penalty_missed",
        "penalty_saved",
        "yellow_card",
        "red_card",
        "save",
        "goal_conceded",
        "substitution",
        "goal_disallowed",
        "shootout_scored",
        "shootout_missed",
        "shootout_saved",
        "shot_on_target",
        "shot_off_target",
        "corner",
        "throw_in",
        "free_kick",
        "foul",
        "offside"
      ]
    },
    "player_id": {
      "type": "string"
    },
    "related_player_id": {
      "type": "string",
      "description": "passeur (but) / joueur sortant (remplacement) / tireur (arrêt)"
    },
    "parent_event_id": {
      "type": "string",
      "description": "lie un événement dérivé à son origine (passe → but, tir cadré auto → but)"
    },
    "auto": {
      "type": "boolean",
      "default": false,
      "description": "créé automatiquement (tir cadré auto)"
    },
    "operator": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "match_id",
    "type",
    "team_id"
  ]
}
