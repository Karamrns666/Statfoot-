{
  "name": "Competition",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Phase de ligue / Gold Cup / Silver Cup / Phase finale"
    },
    "phase": {
      "type": "string",
      "enum": [
        "league_phase",
        "gold",
        "silver",
        "knockout",
        "groups",
        "other"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "swiss",
        "league",
        "groups_knockout",
        "knockout",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "finished",
        "archived"
      ]
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "ex. [1..5] ligue, [6..10] cups"
    },
    "default_pitch": {
      "type": "string",
      "description": "Terrain 1 = Gold, Terrain 2 = Silver"
    },
    "half_duration_min": {
      "type": "integer",
      "default": 15
    },
    "extra_time": {
      "type": "object",
      "description": "{ enabled, period_min }"
    },
    "foul_alert_threshold": {
      "type": "integer",
      "default": 5
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "split": {
      "type": "object",
      "description": "Phase de sélection : places menant aux divisions",
      "properties": {
        "gold_to": {
          "type": "number"
        },
        "silver_from": {
          "type": "number"
        },
        "gold_name": {
          "type": "string"
        },
        "silver_name": {
          "type": "string"
        }
      }
    },
    "parent_id": {
      "type": "string",
      "description": "Compétition d'origine (phase de sélection)"
    },
    "draw_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Art. 17.3 : ordre fixé par tirage au sort"
    }
  },
  "required": [
    "season_id",
    "name",
    "phase"
  ]
}