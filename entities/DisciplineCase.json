    "season_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "incident": {
      "type": "string"
    },
    "proposed_matches": {
      "type": "number"
    },
    "vote_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "decided"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "warning",
        "suspension"
      ]
    },
    "decision_matches": {
      "type": "number"
    },
    "decided_at": {
      "type": "string"
    },
    "suspension_id": {
      "type": "string"
    },
    "pv_id": {
      "type": "string"
    }
  },
  "required": [
    "season_id",
    "player_id",
    "team_id",
    "incident",
    "status"
  ]
