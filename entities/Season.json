{
  "name": "Season",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "closed"
      ]
    },
    "is_active": {
      "type": "boolean"
    },
    "league_phase_rounds": {
      "type": "integer",
      "default": 5
    },
    "cup_rounds": {
      "type": "integer",
      "default": 5
    },
    "gold_size": {
      "type": "integer",
      "default": 10
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rulebook_version": {
      "type": "string",
      "description": "version du règlement Ardentia applicable"
    }
  },
  "required": [
    "name",
    "start_date"
  ]
}