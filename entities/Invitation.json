{
  "name": "Invitation",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "league_admin",
        "scorer"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked"
      ],
      "default": "pending"
    },
    "invited_by": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "app_role"
  ]
}
