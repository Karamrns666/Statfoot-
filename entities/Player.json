{
  "name": "Player",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "enum": [
        "GK",
        "FIELD"
      ],
      "description": "Rôle : GK = gardien, FIELD = joueur de champ (6 contre 6, pas de postes)"
    },
    "number": {
      "type": "integer"
    },
    "team_id": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "injured",
        "inactive"
      ]
    },
    "is_captain": {
      "type": "boolean"
    },
    "season_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "1 seule → badge « Recrue · 1re saison »"
    },
    "rookie": {
      "type": "boolean",
      "description": "Recrue (1re saison dans la ligue). Si absent : déduit du nombre de saisons jouées."
    },
    "email": {
      "type": "string",
      "description": "compte joueur"
    },
    "documents": {
      "type": "object",
      "description": "{ id_card|medical|license: { status: valid|missing|refused|pending, file_url, reason, validated_by } }"
    },
    "photo_cutout_url": {
      "type": "string",
      "description": "Photo détourée (PNG transparent) pour la carte joueur"
    },
    "photo_cutout_status": {
      "type": "string",
      "enum": [
        "ok",
        "failed"
      ]
    }
  },
  "required": [
    "first_name",
    "last_name",
    "position",
    "team_id"
  ]
}
