{
  "name": "Match",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string"
    },
    "competition_id": {
      "type": "string"
    },
    "round": {
      "type": "integer"
    },
    "stage": {
      "type": "string",
      "enum": [
        "league_phase",
        "cup",
        "group",
        "round_of_16",
        "quarter",
        "semi",
        "third_place",
        "final"
      ]
    },
    "bracket_slot": {
      "type": "string"
    },
    "home_source": {
      "type": "object"
    },
    "away_source": {
      "type": "object"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "pitch": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "home_team_id": {
      "type": "string"
    },
    "away_team_id": {
      "type": "string"
    },
    "home_score": {
      "type": "integer"
    },
    "away_score": {
      "type": "integer"
    },
    "home_ht_score": {
      "type": "integer"
    },
    "away_ht_score": {
      "type": "integer"
    },
    "extra_time": {
      "type": "boolean"
    },
    "penalties": {
      "type": "boolean"
    },
    "home_pens": {
      "type": "integer"
    },
    "away_pens": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "finished",
        "postponed",
        "cancelled"
      ]
    },
    "published": {
      "type": "boolean"
    },
    "validated": {
      "type": "boolean",
      "description": "clôturé → XP officiel"
    },
    "validated_at": {
      "type": "string"
    },
    "validated_by": {
      "type": "string"
    },
    "opponent_rank_snapshot": {
      "type": "object",
      "description": "{ home_rank, away_rank } : rang de chaque équipe avant le match (sert au multiplicateur adversaire), figé à la clôture"
    },
    "motm_player_id": {
      "type": "string"
    },
    "motm_vote_closes_at": {
      "type": "string"
    },
    "referee": {
      "type": "string"
    },
    "assistant_referees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_user_id": {
      "type": "string",
      "description": "opérateur attribué"
    },
    "source": {
      "type": "string",
      "enum": [
        "match_center",
        "quick_entry",
        "manual"
      ]
    },
    "sheet": {
      "type": "object",
      "description": "{ filled_at, filled_by, actions_count, referee_signature, manager_signature, signed_at, status }"
    },
    "half_duration_min": {
      "type": "integer",
      "default": 15
    }
  },
  "required": [
    "season_id",
    "competition_id",
    "home_team_id",
    "away_team_id"
  ]
}
