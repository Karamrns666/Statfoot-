    },
    "secondary_color": {
      "type": "string"
    },
    "division_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "captain_player_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
