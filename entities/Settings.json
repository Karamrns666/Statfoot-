{
  "name": "Settings",
  "type": "object",
  "properties": {
    "league_name": {
      "type": "string"
    },
    "short_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "organizer": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "socials": {
      "type": "object",
      "description": "{instagram, facebook, linkedin, tiktok, youtube, x}"
    },
    "points_win": {
      "type": "integer",
      "default": 3
    },
    "points_draw": {
      "type": "integer",
      "default": 1
    },
    "points_loss": {
      "type": "integer",
      "default": 0
    },
    "tiebreakers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "points",
          "head_to_head",
          "goal_diff",
          "goals_for",
          "wins",
          "fair_play",
          "fewer_played"
        ]
      },
      "default": [
        "points",
        "goal_diff",
        "goals_for",
        "head_to_head",
        "fair_play"
      ]
    },
    "starters_count": {
      "type": "integer",
      "default": 6
    },
    "match_duration_minutes": {
      "type": "integer",
      "default": 40
    },
    "awards_min_matches": {
      "type": "integer",
      "default": 3
    },
    "young_max_age": {
      "type": "integer",
      "default": 23
    },
    "motm_vote_enabled": {
      "type": "boolean",
      "default": true
    },
    "motm_vote_weight": {
      "type": "number",
      "default": 0,
      "description": "0 = vote purement consultatif"
    }
  }
}
