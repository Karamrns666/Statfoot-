{
  "name": "Award",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string"
    },
    "competition_id": {
      "type": "string",
      "description": "vide = toute la saison"
    },
    "period": {
      "type": "string",
      "enum": [
        "season",
        "league_phase",
        "competition"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "player_of_tournament",
        "ballon_or",
        "top_scorer",
        "top_assist",
        "golden_glove",
        "best_defender",
        "best_midfielder",
        "best_forward",
        "best_young",
        "best_team",
        "best_defense",
        "best_attack"
      ]
    },
    "player_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "value": {
      "type": "number",
      "description": "XP, buts, rating… selon catégorie"
    },
    "snapshot": {
      "type": "object",
      "description": "stats figées au moment de la validation"
    },
    "not_awarded": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "generated",
        "verified",
        "published"
      ],
      "default": "generated"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "verified_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "poster_url": {
      "type": "string"
    }
  },
  "required": [
    "season_id",
    "category"
  ]
}
