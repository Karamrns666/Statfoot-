{
  "name": "PlayerDocument",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "id_card",
        "medical_certificate",
        "company_license"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "missing",
        "pending",
        "valid",
        "refused"
      ],
      "default": "missing"
    },
    "refusal_reason": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "validated_by": {
      "type": "string"
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "player_id",
    "type"
  ]
}
